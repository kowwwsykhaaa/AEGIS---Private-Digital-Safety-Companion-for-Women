# AEGIS — Digital Safety Intelligence
# Environment Configuration Template

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database (Default: local SQLite zero-config)
DATABASE_URL=sqlite:///./aegis_safety.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/aegis_safety

# Evidence Vault Storage
EVIDENCE_STORAGE_PATH=./evidence_vault

# Cryptographic Salt / Secret Key
SECRET_KEY=replace_with_a_secure_random_production_secret_key_32_chars_min

# Official Indian Helplines
HELPLINE_EMERGENCY=112
HELPLINE_WOMEN=181
HELPLINE_CYBERCRIME=1930
